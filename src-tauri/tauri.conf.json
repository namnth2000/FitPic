{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FitPic",
  "version": "../package.json",
  "identifier": "com.namnth.fitpic",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FitPic",
        "width": 1180,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "namnth2000",
    "homepage": "https://fitpic.namnth.com/",
    "license": "MIT",
    "shortDescription": "Format images for social media, entirely offline.",
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "offlineInstaller" }
    }
  }
}
